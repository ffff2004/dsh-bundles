{
  "name": "@local/dsh-codex-live",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Registers a codex-live provider whose model catalog follows the local codex CLI state.",
  "meta": {
    "title": "OpenAI Codex (live)",
    "description": "Adds a `codex-live` provider whose models follow the local codex CLI catalog (~/.codex/models_cache.json) and whose requests carry the codex CLI's own ChatGPT token (~/.codex/auth.json)."
  },
  "exports": {
    ".": "./index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "scripts": { "test": "node --test" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@earendil-works/pi-ai": "1.3.0"
  }
}
