{
  "name": "@local/dsh-shell-description",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hide the description argument of one-shot bash and pwsh tools across agent presets.",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.2.2-0" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
