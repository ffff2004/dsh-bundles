{
  "name": "dsh-bundles-tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "syncpack lint && eslint . && node scripts/check-market-scope.mjs && node scripts/check-dependencies.mjs",
    "test:lint": "node --test scripts/dependencies.test.mjs scripts/bundle-scope.test.mjs",
    "test:release": "node --test scripts/release*.test.mjs scripts/market*.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "eslint": "10.13.0",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-import-x": "4.17.1",
    "semver": "7.8.5",
    "syncpack": "15.3.3",
    "yaml": "2.9.1"
  }
}
