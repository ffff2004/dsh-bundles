{
  "name": "@local/dsh-preview-download",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "meta": {
    "title": "Preview download",
    "description": "Adds a download control to the Web document-preview toolbar, streaming the previewed workspace file from an authenticated Host route."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "scripts": { "test": "node check.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-documentpreview"]
    }
  }
}
