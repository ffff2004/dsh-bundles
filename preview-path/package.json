{
  "name": "@local/dsh-preview-path",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Make the Web document-preview path row editable, opening the typed workspace file in place.",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.2.2-0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node check.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-documentpreview"]
    }
  }
}
