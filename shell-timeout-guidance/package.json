{
  "name": "@local/dsh-shell-timeout-guidance",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "Encourages models to omit unnecessary bash and pwsh timeoutMs overrides.",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
